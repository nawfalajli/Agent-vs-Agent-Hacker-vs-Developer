# ---------- Repositories ----------
# name|path|test command ; separated. Use a DEDICATED clean clone per repo (the service resets it
# between findings). The test command is how the service verifies proofs and fixes.
REPOS=app|/path/to/automation/app|npm test
DEFAULT_REPO=app
# Where the Hacker writes its regression tests. Reverted for everyone but the Hacker; the project's
# test command must discover tests here (e.g. it already runs **/*.test.* or you add this path).
HVD_TEST_DIR=__hvd__

# ---------- Git: push each fix + open a merge request ----------
# GIT_PUSH=false keeps every fix on a LOCAL branch only (no network, no MR).
GIT_PUSH=true
GIT_REMOTE=origin
# Fix branches are hvd/<finding>-<slug>, pushed with a GitLab merge request into this branch.
GIT_TARGET_BRANCH=dev
GIT_BRANCH_PREFIX=hvd/
# Labels added to each MR via push options
MR_LABELS=security
# Optional commit identity (falls back to the repo's git config)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=

# ---------- Models (both agents run in Claude Code, on any of these providers) ----------
# USA:   anthropic (default) | openrouter (OpenAI GPT, Google Gemini, xAI Grok, Meta Llama, ...)
# China: deepseek | qwen | kimi | glm | minimax     Other: custom (Anthropic-compatible endpoint)
LLM_PROVIDER=anthropic
LLM_MODEL=
# Optional per-agent override (e.g. a stronger model for the Hacker). Empty = LLM_MODEL.
HACKER_MODEL=
DEVELOPER_MODEL=
# anthropic: leave empty to use your logged-in Claude Code session, or set an API key
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
MINIMAX_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
# Every preset endpoint can be overridden with <PROVIDER KEY NAME>_BASE_URL, e.g. DEEPSEEK_BASE_URL

# ---------- Claude Code (the agent runtime) ----------
CLAUDE_BIN=claude
HACKER_TIMEOUT_MINUTES=15
DEVELOPER_TIMEOUT_MINUTES=30
TEST_TIMEOUT_MINUTES=15
# Tools the Developer may use (comma separated). Empty = safe default (edit/search + test/lint/typecheck).
CLAUDE_ALLOWED_TOOLS=

# ---------- Jev referee (optional, TypeSafe AI) ----------
# Decides real / in-scope / duplicate / severity with calibrated confidence. Empty key = Jev off
# (the Hacker's call stands, but a finding still needs a FAILING test before it is acted on).
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.7

# ---------- The loop ----------
# Findings below this severity are logged but not fixed
SEVERITY_MIN=medium
# Consecutive clean passes required to call the app production-ready
CLEAN_PASSES=2
# Fix attempts per finding before giving up
MAX_ROUNDS=3
# Hard ceiling on passes per run (stops a run that never converges)
MAX_TOTAL_ROUNDS=20
# Findings handled per pass
MAX_FINDINGS_PER_PASS=5
# Optional path globs to limit recon, e.g. src/**,!src/vendor/**
HUNT_SCOPE=
# conversation.log, transcript.jsonl, report.md, scoreboard go here
REPORT_DIR=./reports

# ---------- WhatsApp (optional): a message for every fix ----------
# Provider: twilio | meta | callmebot  (empty = off). Sent only to WHATSAPP_TO.
WHATSAPP_PROVIDER=
WHATSAPP_TO=
# Outcomes to notify. Include 'fixed' for a message on EVERY fix; 'ready' for production-ready.
WHATSAPP_EVENTS=fixed,unresolved,ready
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
CALLMEBOT_API_KEY=
